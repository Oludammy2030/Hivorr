#!/bin/sh
# Pre-push guard: protected-branch policy plus secret scan.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
# or:
#   pnpm hooks:install
#
# See scripts/pre-push.mjs and documents/Engineering-Execution/BRANCH_PROTECTION.md.

root=$(git rev-parse --show-toplevel) || exit 1

if command -v node >/dev/null 2>&1; then
  node "$root/scripts/pre-push.mjs"
  status=$?
else
  echo "pre-push: node not found - policy checks cannot run" >&2
  echo "pre-push: install the pinned toolchain (mise) before pushing" >&2
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: push blocked." >&2
  exit 1
fi

exit 0
