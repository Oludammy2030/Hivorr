# Hivorr Staging Environment Configuration Template
#
# PLACEHOLDERS ONLY — no real credentials.
# Local .env files are git-ignored. Only *.example templates are tracked.

HIVORR_ENV=staging

# Staging Supabase project URL (must be HTTPS)
HIVORR_SUPABASE_URL=https://your-staging-project.supabase.co

# Staging Supabase public client (anon) key
HIVORR_SUPABASE_ANON_KEY=your-staging-public-anon-key

HIVORR_CONFIG_SCHEMA_VERSION=1

# Feature flags — Staging mirrors Production defaults unless explicitly tested.
HIVORR_FEATURE_ENABLE_VERBOSE_LOGGING=false
HIVORR_FEATURE_ENABLE_OFFLINE_SYNC=false
HIVORR_FEATURE_ENABLE_ANALYTICS_TRACKING=false
HIVORR_FEATURE_ENABLE_DYNAMIC_WORKSPACE_LOADING=false
