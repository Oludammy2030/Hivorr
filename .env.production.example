# Hivorr Production Environment Configuration Template
#
# PLACEHOLDERS ONLY — no real credentials.
# Local .env files are git-ignored. Only *.example templates are tracked.
# Experimental testing is strictly prohibited in Production (ENV-004).

HIVORR_ENV=production

# Production Supabase project URL (must be HTTPS)
HIVORR_SUPABASE_URL=https://your-prod-project.supabase.co

# Production Supabase public client (anon) key
HIVORR_SUPABASE_ANON_KEY=your-prod-public-anon-key

HIVORR_CONFIG_SCHEMA_VERSION=1

# Feature flags — Production defaults to safe disabled state.
# No flag silently enables experimental behavior in Production.
HIVORR_FEATURE_ENABLE_VERBOSE_LOGGING=false
HIVORR_FEATURE_ENABLE_OFFLINE_SYNC=false
HIVORR_FEATURE_ENABLE_ANALYTICS_TRACKING=false
HIVORR_FEATURE_ENABLE_DYNAMIC_WORKSPACE_LOADING=false

# ─── Payment gateway configuration (EP-02-09) — Production ───────────
# Placeholders only — never commit real live secrets.
HIVORR_PAYMENT_DEFAULT_PROVIDER=paystack
HIVORR_PAYSTACK_PUBLIC_KEY=pk_live_placeholder
HIVORR_PAYSTACK_SECRET_KEY=sk_live_placeholder
HIVORR_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_placeholder
HIVORR_FLUTTERWAVE_SECRET_KEY=FLWSECK_placeholder
HIVORR_NIBSS_BASE_URL=
HIVORR_NIBSS_API_KEY=
