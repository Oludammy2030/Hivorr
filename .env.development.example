# Hivorr Development Environment Configuration Template
#
# PLACEHOLDERS ONLY — no real credentials.
# Local .env files are git-ignored. Only *.example templates are tracked.

HIVORR_ENV=development

# Development Supabase project URL (must be HTTPS)
HIVORR_SUPABASE_URL=https://your-dev-project.supabase.co

# Development Supabase public client (anon) key
HIVORR_SUPABASE_ANON_KEY=your-dev-public-anon-key

HIVORR_CONFIG_SCHEMA_VERSION=1

# Feature flags — Development allows experimental toggles.
HIVORR_FEATURE_ENABLE_VERBOSE_LOGGING=true
HIVORR_FEATURE_ENABLE_OFFLINE_SYNC=false
HIVORR_FEATURE_ENABLE_ANALYTICS_TRACKING=false
HIVORR_FEATURE_ENABLE_DYNAMIC_WORKSPACE_LOADING=false

# ─── Payment gateway configuration (EP-02-09) — Development sandbox ──
# Placeholders only — never commit real secrets.
HIVORR_PAYMENT_DEFAULT_PROVIDER=paystack
HIVORR_PAYSTACK_PUBLIC_KEY=pk_test_placeholder
HIVORR_PAYSTACK_SECRET_KEY=sk_test_placeholder
HIVORR_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_placeholder
HIVORR_FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_placeholder
HIVORR_NIBSS_BASE_URL=
HIVORR_NIBSS_API_KEY=
