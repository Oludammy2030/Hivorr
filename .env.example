# Hivorr Multi-Environment Configuration Template
#
# This file documents the compile-time variable contract for EP-01-03.
# It contains PLACEHOLDERS ONLY — no real Supabase URLs, keys, credentials,
# tokens, or deployment secrets.
#
# Local .env files are git-ignored. Only *.example templates are tracked.
# Do not commit real environment files.
#
# Pass values to Flutter via --dart-define:
#   flutter run \
#     --dart-define=HIVORR_ENV=development \
#     --dart-define=HIVORR_SUPABASE_URL=https://your-project.supabase.co \
#     --dart-define=HIVORR_SUPABASE_ANON_KEY=your-public-anon-key \
#     --dart-define=HIVORR_CONFIG_SCHEMA_VERSION=1
#
# Future CI/CD pipelines (EP-01-04) will map these variables to
# --dart-define values automatically.

# ─── Required variables ──────────────────────────────────────────────

# Environment identity: development | staging | production
HIVORR_ENV=development

# Supabase project URL (must be HTTPS)
HIVORR_SUPABASE_URL=https://your-project.supabase.co

# Supabase public client (anon) key — never a service-role key
HIVORR_SUPABASE_ANON_KEY=your-public-anon-key

# Configuration schema version (currently supported: 1)
HIVORR_CONFIG_SCHEMA_VERSION=1

# ─── Feature flags (strict boolean: true | false) ────────────────────
# Defaults to false when absent. Safe disabled-by-default.

HIVORR_FEATURE_ENABLE_VERBOSE_LOGGING=false
HIVORR_FEATURE_ENABLE_OFFLINE_SYNC=false
HIVORR_FEATURE_ENABLE_ANALYTICS_TRACKING=false
HIVORR_FEATURE_ENABLE_DYNAMIC_WORKSPACE_LOADING=false

# ─── Payment gateway configuration (EP-02-09) ─────────────────────────
# Placeholders only — never commit real secrets.
# Payment providers are abstracted behind lib/integrations/payment_gateways/.
# Default provider: paystack | flutterwave
HIVORR_PAYMENT_DEFAULT_PROVIDER=paystack
HIVORR_PAYSTACK_PUBLIC_KEY=pk_test_placeholder
HIVORR_PAYSTACK_SECRET_KEY=sk_test_placeholder
HIVORR_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_placeholder
HIVORR_FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_placeholder
# Optional direct NIBSS name-enquiry endpoint (HTTPS). When empty, the
# NameEnquiryService delegates to the active provider's resolve endpoint.
HIVORR_NIBSS_BASE_URL=
HIVORR_NIBSS_API_KEY=
