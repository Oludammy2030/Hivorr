# Hivorr local environment template.
# Copy to .env.local and fill with LOCAL or STAGING sandbox values only.
# Never put a production credential in this file, and never commit a filled copy.

HIVORR_ENV=development
BACKEND_ENVIRONMENT=development

# Supabase project reference (public identifier, not a key).
SUPABASE_PROJECT_REF=
EXPECTED_SUPABASE_PROJECT_REF=
# Topology preflight references (public identifiers).
STAGING_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=

# Connection string. Local development uses a container or a staging sandbox.
DATABASE_URL=

# Optional PEM root certificate for a remote database. Without it, remote
# connections are encrypted but the server is not authenticated.
DATABASE_SSL_CA=

# Shared secret presented by the edge proxy when it forwards the browser host.
EDGE_SHARED_SECRET=

# Session issuer. Development values only. Sessions are opaque tokens, not signed.
SESSION_ISSUER=hivorr-development

# Encrypts TOTP secrets at rest. Generate with: openssl rand -base64 32
# Required in staging and production; leave empty in development to disable MFA endpoints.
MFA_ENCRYPTION_KEY=

# API runtime.
API_PORT=3000
API_HOST=127.0.0.1
LOG_LEVEL=info
# Injected by the deployment; leave empty locally. Both are public identifiers.
RELEASE_SHA=
RELEASE_DIGEST=

# Authentication abuse controls (per process).
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_IDENTIFIER_MAX=10
AUTH_RATE_LIMIT_IP_MAX=30
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MS=900000

# Optional exact CORS allowlist; leave empty for same-origin local development.
CORS_ALLOWED_ORIGINS=

# Transactional email through ZeptoMail (Zoho). Leave the token empty locally:
# the capture adapter records messages instead of sending them.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_URL=https://cpaas.zoho.com/v1.1/email
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hivorr
# Public origin of the main portal, used for invitation links in email.
PUBLIC_APP_ORIGIN=http://localhost:8443
STAFF_EMAIL_DOMAIN=hivorr.com
# Trust proxy forwarding headers. Keep false unless a trusted proxy terminates TLS.
TRUST_PROXY=false

# Worker process. The worker can share DATABASE_URL locally; staging and
# production use a dedicated least-privilege role.
WORKER_DATABASE_URL=
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_MS=5000
WORKER_HEALTH_PORT=3001
WORKER_HEALTH_HOST=127.0.0.1
# Optional stable worker identity. Derived from environment, host and pid when empty.
WORKER_ID=
