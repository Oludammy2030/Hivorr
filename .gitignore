# Hivorr - files that must never be committed.
# Enforced from the first commit (v0.0.1-bootstrap, EP-00-001).

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
# OpenAPI generator output (rebuilt by `pnpm openapi:build`)
server/dist-openapi/
# Generated per-commit release manifest and release-issue body
release-manifest.json
release-issue.md
*.local
*.tsbuildinfo

# Environment and secrets - never commit a real one
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Test and coverage output
coverage/
# Generated visual run output; the approved baseline is committed under visual/baseline
visual/current/
# Generated CI gate output (schema snapshot, diff reports)
artifacts/
tests/__gate_selftest_*
playwright-report/
test-results/
.blob-report/

# Tool caches
.vite/
.cache/
.turbo/

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
